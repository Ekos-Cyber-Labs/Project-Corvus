# Placeholder values only. Copy to a file OUTSIDE this repository and
# point CORVUS_ENV_FILE at it; never commit real secrets.
# Compose refuses to start when CORVUS_ENV_FILE is unset.
# Example: cp .env.example /run/corvus/corvus.env
#          chmod 600 /run/corvus/corvus.env
#          CORVUS_ENV_FILE=/run/corvus/corvus.env docker compose up --build
# DATABASE_URL below is for services inside the Compose network. From the
# dev machine, reach Postgres at 127.0.0.1:55432 (host 5432 belongs to
# another stack; Corvus never touches it).
# SECRET: database password for the Corvus Postgres user (Compose + CLI).
POSTGRES_PASSWORD=change-me
# Postgres role and database created by the compose postgres service.
POSTGRES_USER=corvus
POSTGRES_DB=corvus
# Database URL. Inside Compose use host "postgres"; on the dev machine
# use postgresql://corvus:<password>@127.0.0.1:55432/corvus instead.
DATABASE_URL=postgresql://corvus:corvus@postgres:5432/corvus
# On-prem triage endpoint (OpenAI-compatible). Required, no default.
# Not a secret itself, but keep the file private anyway.
GLIMMER_BASE_URL=http://glimmer-host:8001/v1
# Reasoning-model endpoint. Default is the Meta API below.
META_BASE_URL=https://api.meta.ai/v1
# SECRET: Meta API key. Optional only with MODEL_PROFILE=all-local.
META_API_KEY=
# Backend profile: hybrid (default), all-local, or all-cloud.
MODEL_PROFILE=hybrid
# Wazuh indexer (read-only). URL must be https; leave blank until you
# connect Wazuh (see docs/wazuh.md).
WAZUH_INDEXER_URL=
# Dedicated read-only indexer user. Never use the indexer admin account.
WAZUH_INDEXER_USER=
# SECRET: password for WAZUH_INDEXER_USER.
WAZUH_INDEXER_PASSWORD=
# Path to the indexer CA bundle (root-ca.pem copy). Verification is
# always on; there is no option to disable it.
WAZUH_INDEXER_CA=/run/corvus/wazuh-indexer-ca.pem
# Reserved for a future Wazuh manager-API integration. Declared in
# corvus/settings.py but not read by any current code path; leave blank.
WAZUH_API_URL=
WAZUH_API_USER=
WAZUH_API_PASSWORD=
# Optional tuning (defaults shown in the README "Run it yourself" guide):
# SPEND_CAP_USD=100            # Spend ceiling in USD (not a secret).
# SWEEP_INTERVAL_SECONDS=300   # Sweep loop interval, minimum 30.
# SWEEP_MIN_FLOOR=high         # low, medium, high, or critical.
# SWEEP_MAX_ANALYSES=5         # Analyses per sweep cycle, 0 to 50.
# SWEEP_ALWAYS_INJECTION=true  # Always analyze injection-signal incidents.
# CORVUS_RULE_APPROVERS=       # Optional comma list of allowed approvers.
# CORVUS_WAZUH_LOGTEST_CMD=    # wazuh-logtest bridge command for rules logtest.
